{
	"widgettype":"Form",
	"options":{
		"fields":[
			{
				"name":"recharge_amt",
				"uitype":"float",
				"required":true,
				"label":"充值金额"
			},
			{
				"name":"channel",
				"label":"选择充值方式",
				"uitype":"checkbox",
				"multicheck":false,
				"required":true,
				"value":"alipay",
				"data":[
					{
						"value":"alipay",
						"text":"支付宝"
					}
				]
			}
		]
	},
	"binds":[
		{
			"wid":"self",
			"event":"submit",
			"actiontype":"urlwidget",
			"target":"self",
			"options":{
				"url":"{{entire_url('recharge.dspy')}}"
			}
		}
	]
}
