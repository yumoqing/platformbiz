
product_type = params_kw.product_type
product_id = params_kw.product_id
config_data = params_kw.config_data

if product_type == 'llm':
	r = await llm_query_price(product_id, config_data)
	return {
		"status": "ok",
		"data": {
			"prices": r
		}
	}
return {
	"status": "error",
	"data": {
		"message": f"{product_type=} 未知产品类型"
	}
}
